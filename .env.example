POSTS_PER_DAY=3
MAX_SCRIPT_RETRIES=3
MAX_GENERATION_ROUNDS=3

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=3

APP_ROOT=.
DATA_DIR=data
OUTPUT_DIR=output
CHARACTER_FILE=character/character.json
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json

# 画像素材。無くてもフォールバック画面で動画は生成できます。
CHARACTER_IMAGE=assets/character/default.png
BACKGROUND_DIR=assets/backgrounds
# 任意。著作権上使えるBGMだけ指定してください。空ならBGMなし。
BGM_FILE=

# PC / サーバー共通の投稿スケジュール
APP_TIMEZONE=Asia/Tokyo
POST_TIMES=09:00,15:00,21:00
# 完成まではfalse。trueにするとscheduler.pyが期限到来動画を投稿します。
AUTO_UPLOAD_ENABLED=false
AUTO_UPLOAD_PRIVACY=private

FONT_PATH=C:\\Windows\\Fonts\\meiryo.ttc

# trueの間は通常の --upload 投稿をしません。
DRY_RUN=true
YOUTUBE_PRIVACY_STATUS=private
