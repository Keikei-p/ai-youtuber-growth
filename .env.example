POSTS_PER_DAY=3
MAX_SCRIPT_RETRIES=3
MAX_GENERATION_ROUNDS=3

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=3
# Windows自動起動用。VOICEVOXのexeが分かれば設定。
VOICEVOX_EXE=

APP_ROOT=.
DATA_DIR=data
OUTPUT_DIR=output
CHARACTER_FILE=character/character.json
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json

CHARACTER_IMAGE=assets/character/default.png
BACKGROUND_DIR=assets/backgrounds
BGM_FILE=

APP_TIMEZONE=Asia/Tokyo
POST_TIMES=09:00,15:00,21:00
POST_GRACE_MINUTES=20
AUTO_UPLOAD_ENABLED=false
AUTO_UPLOAD_PRIVACY=private

# ゲスト運用。7本に1回出演、18本ごとに新キャラ候補生成。
GUEST_APPEARANCE_EVERY=7
GUEST_NEW_EVERY=18
GUEST_MAX_ACTIVE=6
# Stable Diffusion WebUI / Forge互換APIを後で接続可能。
GUEST_IMAGE_ENABLED=false
SD_WEBUI_URL=http://127.0.0.1:7860

# YouTubeメタデータ
YOUTUBE_CATEGORY_ID=22
YOUTUBE_DEFAULT_LANGUAGE=ja
# 現状のアニメ表現ではfalse。必要な表現を使う時だけtrueへ。
YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=false

# YouTubeアップロード成功後にMP4と音声WAVを自動削除。
# 投稿失敗時は再試行用に残します。
CLEANUP_AFTER_UPLOAD=true

FONT_PATH=C:\Windows\Fonts\meiryo.ttc

DRY_RUN=true
YOUTUBE_PRIVACY_STATUS=private
