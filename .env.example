POSTS_PER_DAY=3
MAX_SCRIPT_RETRIES=3
MAX_GENERATION_ROUNDS=3

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# auto: 自作Brain学習済みなら自作を優先、未完成中だけOllamaへ移行フォールバック。
# mirai_native: 外部LLMを使わず自作Brainのみ。
# ollama: 移行用。
MIRAI_TEXT_PROVIDER=auto

VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=3
# Windows自動起動用。VOICEVOXのexeが分かれば設定。
VOICEVOX_EXE=

APP_ROOT=.
DATA_DIR=data
OUTPUT_DIR=output

# 制作の実行場所。
# local: 今まで通りこのPCで画像/音声/FFmpeg/品質検査
# cloud: CLOUD_EXECUTION_URL のExecution Workerへ制作ジョブを送る
EXECUTION_MODE=local
CLOUD_EXECUTION_URL=
# 秘密情報。必ずローカル.envまたはサーバー環境変数だけに保存。
CLOUD_EXECUTION_TOKEN=
CLOUD_EXECUTION_TIMEOUT_SECONDS=1800
CLOUD_EXECUTION_POLL_SECONDS=5
# cloud未接続/障害時にPC制作へ戻して投稿を止めない。
CLOUD_EXECUTION_FALLBACK_LOCAL=true
# 同じコードを制作サーバー側で起動する時のbind先。
# 127.0.0.1以外へ公開する場合はCLOUD_EXECUTION_TOKEN必須。
CLOUD_WORKER_HOST=127.0.0.1
CLOUD_WORKER_PORT=8766
# trueにするとCloud Worker自身がscheduler.tickを常駐実行し、
# PCがスリープ/電源OFFでもサーバー側で生成・投稿・分析を継続する。
# サーバー側にYouTube認証/Ollama/必要な制作依存が揃ってから有効化。
CLOUD_AUTONOMY_RUNNER=false
# 投稿時刻の確認間隔。重い生成/分析はWEB_INTERVAL_SECONDS相当の既存間隔で実行。
CLOUD_AUTONOMY_POLL_SECONDS=60
CHARACTER_FILE=character/character.json
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json

# ミライ固定キャラクター。画像/動画はこの参照画像を基準にする。
CHARACTER_IMAGE=assets/character/mirai_reference.jpg
MIRAI_REFERENCE_IMAGE=assets/character/mirai_reference.jpg
MIRAI_IDENTITY_LOCK_ENABLED=true
# 小さいほど元の顔・髪・装備を強く保持。GTX 1070向け初期値。
MIRAI_REFERENCE_STRENGTH=0.35
# AI動画OFFでも、採用済みミライ画像から軽量モーションを作る。
MIRAI_IDENTITY_VIDEO_ENABLED=true
BACKGROUND_DIR=assets/backgrounds
BGM_FILE=
# 自分で作ったBGMまたは商用利用・YouTube利用権を確認済みの場合だけtrue。
BGM_LICENSE_CONFIRMED=false

APP_TIMEZONE=Asia/Tokyo
POST_TIMES=09:00,15:00,21:00
POST_GRACE_MINUTES=20
# スリープ/休止から遅れて復帰した場合、この時間内なら直近1本をその場で投稿。
POST_SLEEP_CATCHUP_HOURS=6
AUTO_UPLOAD_ENABLED=false
AUTO_UPLOAD_PRIVACY=private
# 8MB単位のresumable upload。通信断時に全ファイルを送り直しにくくする。
YOUTUBE_UPLOAD_CHUNK_MB=8
# 投稿完了直後にアプリが落ちても、YouTube側の直近投稿を照合して二重投稿を防ぐ。
YOUTUBE_RECONCILE_LOOKBACK_MINUTES=30
YOUTUBE_RECONCILE_GRACE_MINUTES=3

# ゲスト運用。7本に1回出演、18本ごとに新キャラ候補生成。
GUEST_APPEARANCE_EVERY=7
GUEST_NEW_EVERY=18
GUEST_MAX_ACTIVE=6
# Stable Diffusion WebUI / Forge互換APIを後で接続可能。
GUEST_IMAGE_ENABLED=false
SD_WEBUI_URL=http://127.0.0.1:7860

# AI Studio画像生成
# auto: 移行用Diffusers/WebUI。native: 自作Mirai Native Image v0のみ。
STUDIO_IMAGE_BACKEND=auto
STUDIO_DIFFUSERS_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5

# YouTubeメタデータ
YOUTUBE_CATEGORY_ID=22
YOUTUBE_DEFAULT_LANGUAGE=ja
# ミライはAIで音声・画像/映像を制作するため、安全側で常時開示。
# YouTube公式上、この開示自体で視聴制限や収益化資格が下がるものではありません。
YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=true

# YouTubeアップロード成功後にMP4と音声WAVを自動削除。
# 投稿失敗時は再試行用に残します。
CLEANUP_AFTER_UPLOAD=true

FONT_PATH=C:\Windows\Fonts\meiryo.ttc

DRY_RUN=true
YOUTUBE_PRIVACY_STATUS=private

# GPU競合時はOllamaのVRAMを自動解放して再試行。
STUDIO_GPU_RETRIES=2
# CUDAが使えない時の最終手段。CPUでは低解像度・低ステップで生成。
STUDIO_CPU_FALLBACK=true

# 1本のShortsで順番に生成するシーン画像数。
# MEDIA_FAST_MODE=true の時は実運用で1枚へ自動圧縮して高速化。
STUDIO_SCENE_IMAGES_PER_VIDEO=2
# Fast modeは最初の生成だけstepを削減し、品質NG時のみ従来stepで再生成。
STUDIO_FAST_IMAGE_STEPS=18
STUDIO_FAST_BACKGROUND_STEPS=14
# true: 品質基準を維持しつつ、画像候補・背景枚数・GPU往復を削減。
MEDIA_FAST_MODE=true
# auto: GTX 1070等でh264_nvencが使えればGPUエンコード。失敗時はlibx264へ自動退避。
# auto / nvenc / x264
FFMPEG_VIDEO_ENCODER=auto
# Shorts品質基準は24fps以上。高速モードでは24fpsでフレーム処理量を20%削減。
MEDIA_RENDER_FPS=24

# Visual Evolution v1
VISUAL_CANDIDATE_COUNT=2
VISUAL_BACKGROUND_CANDIDATES=1
VISUAL_RETRY_ROUNDS=1
VISUAL_MIN_SCORE=60
VISUAL_VIDEO_MIN_SCORE=60

# Visual Evolution v2。候補比較で勝った1枚だけ高解像度リファイン。
# GTX 1070 8GB向け初期値: 1.5倍 / 低denoise / 10steps。
VISUAL_HIGHRES_ENABLED=true
VISUAL_HIGHRES_SCALE=1.5
VISUAL_HIGHRES_STRENGTH=0.28
VISUAL_HIGHRES_STEPS=10

# AI動画生成。GTX 1070では重いため最初はOFF。
# google: Google Veo 3.1（本番品質）/ animatediff: ローカル移行用 / native: 自作Mirai Native Video v0。
AI_VIDEO_ENABLED=false
AI_VIDEO_BACKEND=native
# 使用するMotion Adapter/モデル重みの商用・公開利用条件を確認した場合だけtrue。
# 未確認のままtrueにしない。
AI_VIDEO_LICENSE_CONFIRMED=false
AI_VIDEO_FRAMES=8
AI_VIDEO_STEPS=12
AI_VIDEO_WIDTH=384
AI_VIDEO_HEIGHT=576

# Google Veo 3.1。AI_VIDEO_BACKEND=google の時に使用。
# APIキーは必ずローカル.envだけに保存し、Gitへコミットしない。
# 初期運用は課金ゼロ。明示的にtrueへ変えるまでGoogle動画生成は絶対に実行しない。
GOOGLE_VIDEO_ENABLED=false
GEMINI_API_KEY=
# 初期値はコストを抑えるFast。品質優先なら veo-3.1-generate-preview。
GOOGLE_VIDEO_MODEL=veo-3.1-fast-generate-preview
# 720pなら4/6/8秒。1080p/4kやreferenceImagesは8秒必須。
GOOGLE_VIDEO_DURATION_SECONDS=4
GOOGLE_VIDEO_RESOLUTION=720p
GOOGLE_VIDEO_ASPECT_RATIO=9:16
# Veo公式の混雑時最大遅延を考慮し、8分で自動打ち切り。
GOOGLE_VIDEO_TIMEOUT_SECONDS=480
GOOGLE_VIDEO_POLL_SECONDS=10
# 1回の制作batchでGoogle課金生成する最大本数。暴走防止。
GOOGLE_VIDEO_MAX_PER_BATCH=3

# 省負荷自動運転。PC操作中は重い自動生成を延期。
RESOURCE_MIN_IDLE_SECONDS=45
RESOURCE_MIN_MEMORY_MB=2500
RESOURCE_MIN_GPU_FREE_MB=1800
# 次の投稿までこの分数以下なら必要最小限で制作を優先。
RESOURCE_URGENT_MINUTES=60

# Nativeモデル自動再学習。
# 新しい教師データ + 4時間以上投稿余裕 + PC省負荷条件 + 7日cooldown時のみ1モデル実行。
# 旧重みをbackupし、benchmark不合格なら自動rollback。
NATIVE_AUTO_TRAIN_ENABLED=true
NATIVE_AUTO_TRAIN_COOLDOWN_HOURS=168
NATIVE_AUTO_TRAIN_POST_GAP_MINUTES=240
NATIVE_AUTO_TRAIN_TIMEOUT_SECONDS=1800

# Mirai Voice Engineの波形生成provider。
# voicevox: 移行中の既存provider
# mirai_local: 自作ミライ音声ソフト（ローカルAPI）
MIRAI_VOICE_PROVIDER=voicevox
MIRAI_TTS_URL=http://127.0.0.1:50150
MIRAI_TTS_TIMEOUT_SECONDS=120
